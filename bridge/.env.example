# Copy this file to .env and fill in real values. Never commit .env itself
# (it holds live credentials) — see the root .gitignore.

# --- Holochain conductor ---

# App API websocket URL. This is what zome calls actually go over.
HOLOCHAIN_URL=ws://localhost:8888

# Admin API websocket URL — a DIFFERENT port from HOLOCHAIN_URL above; the
# conductor's own config declares both independently, so there is no way to
# derive one from the other. Required to issue an app authentication token
# (AdminWebsocket#issueAppAuthenticationToken) and to authorize zome-call
# signing credentials (AdminWebsocket#authorizeSigningCredentials) for every
# cell this app has — both are needed before any callZome() will succeed
# against a real conductor. See HolochainClient#connect in src/index.ts.
HOLOCHAIN_ADMIN_URL=ws://localhost:8889

# Must match an app_id actually installed on the conductor at
# HOLOCHAIN_ADMIN_URL — checked at startup, but the auth-token request
# itself will fail first if it doesn't.
HOLOCHAIN_APP_ID=epistemic-resonance-happ

# --- Twitter API v2 (four-legged OAuth 1.0a user context, via twitter-api-v2) ---

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Polling ---

# Fallback poll interval (ms) for unbridged Mews/Claims, in case a signal
# is missed. Twitter mention polling is a separate, fixed 5-minute interval
# hardcoded in src/index.ts (Twitter's own API rate limits make that
# interval not practically configurable per-deployment).
POLL_INTERVAL_MS=30000
