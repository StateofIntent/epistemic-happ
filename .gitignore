# Rust build artifacts (both zomes)
/dna/integrity/target/
/dna/coordinator/target/
target/
# Cargo.lock is intentionally NOT ignored: both zomes build to wasm
# binaries that get deployed as part of the hApp, not published as
# libraries, so the lockfile is kept for reproducible builds.

# Node / bridge service / mobile UI / domain bootstrap tool / federation bridge
/bridge/node_modules/
/bridge/dist/
/mobile-ui/node_modules/
/mobile-ui/dist/
/domains/node_modules/
/federation/node_modules/
node_modules/
dist/
# Holds live conductor/Twitter credentials — see bridge/.env.example for
# the documented, safe-to-commit template.
/bridge/.env
.env

# SSTorytime local instance (cloned/built by sstorytime/setup.sh)
/sstorytime/.local/

# Packed DNA/hApp bundles (produced by `hc dna pack` / `hc app pack` — see
# README.md §6.2-6.3). Rebuildable from source; not meant to be committed.
/dna/*.dna
/*.happ

# hc sandbox bookkeeping (created by `hc sandbox generate`/`run`, or by
# scripts/sandbox.sh — see README.md §6.6). Point at a throwaway conductor
# data dir under /tmp; nothing here is meant to survive past the sandbox
# that created it.
/.hc
/.hc_auth
/.hc_live_*
/.hc_sandbox.pid
/.hc_sandbox.log

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
