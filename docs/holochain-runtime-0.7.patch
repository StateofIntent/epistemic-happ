                         zomes.push(ZomeManifest {
@@ -207,3 +205,24 @@
     let (dna_file, original_hash) = dna_bundle.into_dna_file(Default::default()).await?;
     Ok((dna_file, original_hash))
 }
+
+/// 0.7 removed `CoordinatorZomeDef::wasm_hash(&ZomeName)`. The hash still lives
+/// on the inner `WasmZomeDef`, reachable through `as_any_zome_def`, so this is
+/// the same value by a different route rather than a behaviour change.
+///
+/// It returns `ZomeError::NonWasmZome` deliberately: that is exactly what 0.7's
+/// own `DnaDef::get_wasm_zome_hash` returns in the same situation, and
+/// `UpdateHappError` already has `#[from] ZomeError`, so `?` keeps working at
+/// the call sites without a new error variant.
+///
+/// `ZomeDef::Inline` sits behind the `full-dna-def` feature, so the match needs
+/// a catch-all rather than being exhaustive over what is visible here.
+fn coordinator_wasm_hash(
+    zome_name: &holochain_types::prelude::ZomeName,
+    def: &holochain_types::prelude::CoordinatorZomeDef,
+) -> std::result::Result<holochain_types::prelude::WasmHash, ZomeError> {
+    match def.as_any_zome_def() {
+        holochain_types::prelude::ZomeDef::Wasm(w) => Ok(w.wasm_hash.clone()),
+        _ => Err(ZomeError::NonWasmZome(zome_name.clone())),
+    }
+}
