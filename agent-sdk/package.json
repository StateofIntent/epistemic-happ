{
  "name": "@stateofintent/agent-sdk",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "description": "Client library for participating in the Epistemic Resonance Protocol as an autonomous agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && cp ../LICENSE-MIT ../LICENSE-APACHE ./",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@holochain/client": "^0.17.0",
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "libsodium-wrappers": "0.7.13",
    "libsodium": "0.7.13"
  },
  "_overridesNote": "libsodium-wrappers 0.7.16 ships a broken ESM build \u2014 its libsodium-wrappers.mjs imports a sibling libsodium.mjs that is not in the published package, so any ESM import of @holochain/client fails with ERR_MODULE_NOT_FOUND. 0.7.13 is what federation/ resolved and works. Remove this override once upstream republishes a working ESM build.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StateofIntent/epistemic-happ.git",
    "directory": "agent-sdk"
  },
  "homepage": "https://github.com/StateofIntent/epistemic-happ#readme",
  "bugs": {
    "url": "https://github.com/StateofIntent/epistemic-happ/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "holochain",
    "p2p",
    "distributed",
    "epistemics",
    "knowledge-graph",
    "agent",
    "autonomous-agents",
    "protocol",
    "sdk",
    "client"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ]
}
